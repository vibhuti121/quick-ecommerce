# Copy to .env.local for local dev. In production the frontend is served from the same origin as the
# gateway (behind Caddy), so this can be left empty there.
#
# Base URL of the API gateway. The dev gateway runs on host port 8088 (8080 is taken by a legacy
# monolith), so point the Vite dev server at it. CORS for this origin is allowed by the gateway
# (ALLOWED_ORIGIN, default http://localhost:5173).
VITE_API_BASE=http://localhost:8088
