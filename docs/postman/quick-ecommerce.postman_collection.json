            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"sku\": \"FRT-NEW-001\",\n  \"name\": \"Updated Fruit\",\n  \"description\": \"Updated\",\n  \"productType\": \"FRUIT\",\n  \"category\": \"fruit\",\n  \"basePrice\": 249.00,\n  \"currency\": \"INR\",\n  \"active\": true,\n  \"variants\": []\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{baseUrl}}/api/catalog/admin/products/{{productId}}", "host": ["{{baseUrl}}"], "path": ["api", "catalog", "admin", "products", "{{productId}}"] },
