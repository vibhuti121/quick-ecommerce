          }
        }
      ]
    },
    {
      "name": "Catalog — Taste Profile (account)",
      "item": [
        {
          "name": "Get taste profile",
          "request": {
            "method": "GET",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{userToken}}", "type": "string" }] },
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/catalog/taste/profile", "host": ["{{baseUrl}}"], "path": ["api", "catalog", "taste", "profile"] },
            "description": "Requires NON-guest Bearer JWT (guest-* tokens 403). Returns XP/tier/rank/badges/streak/persona; zeroed default if none."
          }
        },
        {
          "name": "Upsert taste profile",
          "request": {
            "method": "POST",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{userToken}}", "type": "string" }] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"xp\": 120,\n  \"tier\": \"Sprout\",\n  \"rank\": 4,\n  \"discoveredFruits\": [\"litchi\", \"mango\"],\n  \"badges\": [\"first-taste\"],\n  \"currentStreak\": 3,\n  \"bestStreak\": 5,\n  \"persona\": \"Explorer\",\n  \"state\": \"Karnataka\",\n  \"pincode\": \"560001\"\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{baseUrl}}/api/catalog/taste/profile", "host": ["{{baseUrl}}"], "path": ["api", "catalog", "taste", "profile"] },
            "description": "Requires NON-guest Bearer JWT. Monotonic merge upsert; all fields optional; unknown fields ignored."
          }
        },
        {
          "name": "Merge device progress",
          "request": {
            "method": "POST",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{userToken}}", "type": "string" }] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"deviceProgress\": {\n    \"xp\": 80,\n    \"discoveredFruits\": [\"guava\"],\n    \"currentStreak\": 2\n  }\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{baseUrl}}/api/catalog/taste/profile/merge", "host": ["{{baseUrl}}"], "path": ["api", "catalog", "taste", "profile", "merge"] },
            "description": "Requires NON-guest Bearer JWT. Merges an anonymous device snapshot into the account on login."
          }
        }
      ]
    },
    {
      "name": "Catalog — Admin",
      "item": [
        {
          "name": "List all products (admin)",
          "request": {
            "method": "GET",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }] },
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/catalog/admin/products", "host": ["{{baseUrl}}"], "path": ["api", "catalog", "admin", "products"] },
            "description": "ADMIN only. All products incl. inactive, active-first. Doubly gated (gateway RBAC + AdminRoleFilter)."
          }
        },
        {
          "name": "Create product (admin)",
          "request": {
            "method": "POST",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"sku\": \"FRT-NEW-001\",\n  \"name\": \"Test Fruit\",\n  \"description\": \"A test product\",\n  \"productType\": \"FRUIT\",\n  \"category\": \"fruit\",\n  \"basePrice\": 199.00,\n  \"currency\": \"INR\",\n  \"imageUrl\": null,\n  \"active\": true,\n  \"variants\": []\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{baseUrl}}/api/catalog/admin/products", "host": ["{{baseUrl}}"], "path": ["api", "catalog", "admin", "products"] },
            "description": "ADMIN only. REQUIRED: sku, name, productType, basePrice (>=0). Returns 201 + Location header."
          }
