          }
        },
        {
          "name": "[internal] Release reservation",
          "request": {
            "method": "POST",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/inventory/reservations/{{orderId}}/release", "host": ["{{baseUrl}}"], "path": ["api", "inventory", "reservations", "{{orderId}}", "release"] },
            "description": "INTERNAL saga compensation. Idempotent."
          }
        }
