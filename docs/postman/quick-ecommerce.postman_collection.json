            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"team\": \"BRA\"\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{baseUrl}}/api/catalog/fruit-xi/autofill", "host": ["{{baseUrl}}"], "path": ["api", "catalog", "fruit-xi", "autofill"] },
