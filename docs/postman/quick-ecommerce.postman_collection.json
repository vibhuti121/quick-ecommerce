            "url": { "raw": "{{baseUrl}}/api/inventory/atp/reserve", "host": ["{{baseUrl}}"], "path": ["api", "inventory", "atp", "reserve"] },
            "description": "INTERNAL (order-service calls this). Redis ATP fast pre-check; always 200, result = RESERVED | INSUFFICIENT | DEGRADED. INSUFFICIENT 409s checkout; DEGRADED still allows (DB lock is the real guard)."
          }
        },
        {
          "name": "[internal] Reserve (saga step 1)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"orderId\": \"{{orderId}}\",\n  \"lines\": [\n    { \"sku\": \"{{sku}}\", \"qty\": 1 }\n  ]\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{baseUrl}}/api/inventory/reservations", "host": ["{{baseUrl}}"], "path": ["api", "inventory", "reservations"] },
            "description": "INTERNAL saga step. DB PESSIMISTIC_WRITE lock = durable oversell guard; idempotent on orderId."
          }
        },
        {
          "name": "[internal] Commit reservation",
          "request": {
            "method": "POST",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/inventory/reservations/{{orderId}}/commit", "host": ["{{baseUrl}}"], "path": ["api", "inventory", "reservations", "{{orderId}}", "commit"] },
