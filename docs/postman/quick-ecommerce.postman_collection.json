          }
        },
        {
          "name": "All notify signups (admin)",
          "request": {
            "method": "GET",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }] },
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/catalog/admin/notify", "host": ["{{baseUrl}}"], "path": ["api", "catalog", "admin", "notify"] },
            "description": "ADMIN only. Full notify rows incl. PII — founder's demand console."
          }
        },
        {
          "name": "Demand aggregate (admin)",
          "request": {
            "method": "GET",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }] },
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/catalog/admin/notify/demand", "host": ["{{baseUrl}}"], "path": ["api", "catalog", "admin", "notify", "demand"] },
            "description": "ADMIN only. Aggregated demand: headcount, per-fruit, per-state, latest leads."
          }
        }
      ]
    },
    {
      "name": "Cart",
      "item": [
        {
          "name": "Get cart",
          "request": {
            "method": "GET",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{userToken}}", "type": "string" }] },
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/cart", "host": ["{{baseUrl}}"], "path": ["api", "cart"] },
            "description": "Requires Bearer JWT (guest OK). Empty cart returns {items:{}, total:0, itemCount:0}. Swap to {{guestToken}} to test guest cart."
          }
        },
        {
          "name": "Add / update cart item",
          "request": {
            "method": "POST",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{userToken}}", "type": "string" }] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"productId\": {{productId}},\n  \"quantity\": 1\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{baseUrl}}/api/cart/items", "host": ["{{baseUrl}}"], "path": ["api", "cart", "items"] },
            "description": "Requires Bearer JWT. quantity is a SIGNED DELTA (+1 adds, -1 removes; <=0 removes line). HONEY 400s here (category==='honey', \"coming soon\") — use a fruit productId."
          }
        },
        {
          "name": "Remove cart line",
          "request": {
            "method": "DELETE",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{userToken}}", "type": "string" }] },
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/cart/items/{{productId}}", "host": ["{{baseUrl}}"], "path": ["api", "cart", "items", "{{productId}}"] },
            "description": "Requires Bearer JWT. Removes one line, returns updated cart."
          }
        },
        {
          "name": "Clear cart",
          "request": {
            "method": "DELETE",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{userToken}}", "type": "string" }] },
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/cart", "host": ["{{baseUrl}}"], "path": ["api", "cart"] },
            "description": "Requires Bearer JWT. Empties the entire cart."
          }
        }
      ]
    },
    {
      "name": "Orders",
      "item": [
        {
          "name": "Checkout",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Fresh idempotency key per send so retries don't 409 unintentionally.",
                  "pm.collectionVariables.set('idempotencyKey', 'pm-' + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "if (j && j.orderId) { pm.collectionVariables.set('orderId', j.orderId); console.log('saved orderId ' + j.orderId); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{userToken}}", "type": "string" }] },
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{idempotencyKey}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"currency\": \"INR\",\n  \"customerName\": \"Test Buyer\",\n  \"customerPhone\": \"9999999999\",\n  \"deliveryAddress\": \"1 MG Road\",\n  \"pincode\": \"560001\",\n  \"city\": \"Bangalore\",\n  \"state\": \"Karnataka\",\n  \"items\": [\n    {\n      \"productId\": {{productId}},\n      \"sku\": \"{{sku}}\",\n      \"name\": \"Test Fruit\",\n      \"unitPrice\": 199.00,\n      \"quantity\": 1\n    }\n  ]\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{baseUrl}}/api/orders/checkout", "host": ["{{baseUrl}}"], "path": ["api", "orders", "checkout"] },
            "description": "Requires NON-guest Bearer JWT (guest-* 403). `Idempotency-Key` header REQUIRED (missing = 400; pre-request script auto-generates one). Returns 202 ACCEPTED, saga-driven. All items must be fruit (honey rejected), oversell 409, duplicate order 409. Required body fields: currency, customerName, customerPhone, deliveryAddress, pincode, city, state, items[] (productId, sku, name, unitPrice>=0, quantity>=1)."
          }
        },
        {
          "name": "Get order by id",
          "request": {
            "method": "GET",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{userToken}}", "type": "string" }] },
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/orders/{{orderId}}", "host": ["{{baseUrl}}"], "path": ["api", "orders", "{{orderId}}"] },
            "description": "Requires Bearer JWT. Order detail (no per-user ownership check — shareable by link)."
          }
        },
        {
          "name": "My orders",
          "request": {
            "method": "GET",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{userToken}}", "type": "string" }] },
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/orders", "host": ["{{baseUrl}}"], "path": ["api", "orders"] },
            "description": "Requires Bearer JWT. The caller's order history, newest first."
          }
        }
      ]
    },
