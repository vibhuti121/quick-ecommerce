# Copy to .env and adjust. Every value has a safe local default in docker-compose.yml, so the stack
# runs with no .env at all — these are the knobs you'll change when moving local -> cloud.

# Postgres password (shared by all services in dev; use a secret manager in cloud)
DB_PASSWORD=postgres

# Secret used to sign/verify JWTs. MUST be >= 32 bytes (HS256 = 256-bit key) or jjwt rejects it;
# set a long random value outside local dev.
JWT_SECRET=varsha-dev-jwt-secret-min-256-bits-change-me

# Google OAuth2 (optional locally — guest tokens cover the full journey). Fill these to enable
# "Sign in with Google". Dummy values let auth-service boot for guest-only flows.
GOOGLE_CLIENT_ID=dummy-client-id
GOOGLE_CLIENT_SECRET=dummy-client-secret

# Payment provider bean to activate. "mock" approves everything except the .66 decline test hook.
PAYMENT_PROVIDER=mock

# How often the order saga drains its outbox (ms).
OUTBOX_POLL_INTERVAL_MS=2000

# Frontend origin allowed through CORS at the gateway.
ALLOWED_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173
