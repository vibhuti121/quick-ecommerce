# Template only — DO NOT put real secrets here (this file IS committed).
#
# The stack is fail-closed: docker-compose.yml references every secret as ${VAR:?...}, so
# `docker compose up` refuses to start until a real .env supplies values. Bootstrap it with:
#
#     ./scripts/gen-secrets.sh        # writes a gitignored .env with strong random secrets
#
# Only edit a value below if you want to override a generated one (e.g. real Google creds, admins).
# The placeholders here are NOT valid secrets — they exist to document each variable.

# --- Secrets (REQUIRED; generated by gen-secrets.sh, never defaulted in source) ---
# Postgres password, shared by all services in dev. In cloud, source from a secret manager.
DB_PASSWORD=__generate_me__
# JWT signing key. MUST be >= 32 bytes (HS256 = 256-bit) or jjwt rejects it. Rotating invalidates
# all issued tokens. There is intentionally no default anywhere — a key in source = forgeable tokens.
JWT_SECRET=__generate_me__
# MinIO (S3-compatible object storage) root credentials.
MINIO_ROOT_USER=__generate_me__
MINIO_ROOT_PASSWORD=__generate_me__
# Grafana admin password (admin user is GRAFANA_USER, default 'admin').
GRAFANA_PASSWORD=__generate_me__
# Password for the gateway's dev self-signed TLS keystore (Phase 3, Pillar 4). Used at BOTH image
# build (to create keystore.p12) and runtime (to open it) — keep them one value. This is a dev cert,
# not a real trust anchor; a production deploy mounts a CA-signed keystore and sets this to its password.
TLS_KEYSTORE_PASSWORD=__generate_me__

# --- Optional / non-secret knobs (safe defaults live in docker-compose.yml) ---
# Google OAuth2 (optional locally — guest tokens cover the full journey). Fill to enable Google login;
# dummies let auth-service boot for guest-only flows.
GOOGLE_CLIENT_ID=dummy-client-id
GOOGLE_CLIENT_SECRET=dummy-client-secret

# RBAC: comma-separated emails promoted to ADMIN at login (Phase 3, Pillar 1). Only these users can
# hit /api/catalog/admin/** and /api/inventory/admin/**. Empty → no admins (locked down). Admins must
# sign in with Google (guests are always USER), so set real account emails here.
ADMIN_EMAILS=

# Payment provider bean to activate. "mock" approves everything except the .66 decline test hook.
PAYMENT_PROVIDER=mock

# How often the order saga drains its outbox (ms).
OUTBOX_POLL_INTERVAL_MS=2000

# Frontend origin allowed through CORS at the gateway.
ALLOWED_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Rate-limit IP trust (Phase 3, Pillar 5). Leave false: the gateway is the directly-exposed edge, so
# the per-client limit keys on the real TCP peer. Set true ONLY when running behind a trusted reverse
# proxy/LB that overwrites X-Forwarded-For (also flip it on to run the journey load test, which fakes
# many distinct clients via XFF). Trusting a client-controlled header on the open edge = trivial bypass.
RATE_LIMIT_TRUST_FORWARDED_FOR=false
